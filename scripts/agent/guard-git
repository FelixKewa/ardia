#!/usr/bin/env python3
import json, os, re, subprocess, sys, time

try:
    payload = json.load(sys.stdin)
    command = payload.get("tool_input", {}).get("command", "")
    cwd = payload.get("cwd") or os.getcwd()
except Exception:
    sys.exit(0)

G = r"(?:^|[;&|(`\n]\s*|\$\(\s*)(?:\w+=\S*\s+)*git\s+(?:-C\s+(?P<dir>\"[^\"]*\"|'[^']*'|\S+)\s+)?"
rules = [
    (G + r"checkout\b(?!\s+-b\b)", "git checkout"),
    (G + r"restore\b(?![^;&|\n]*--staged)", "git restore (without --staged)"),
    (G + r"stash\b", "git stash"),
    (G + r"reset\b[^;&|\n]*--hard", "git reset --hard"),
    (G + r"clean\b", "git clean"),
    (G + r"switch\b", "git switch"),
]
WORD = re.compile(r"\"(?:[^\"\\]|\\.)*\"|'[^']*'|[^\s;&|()`<>]+")
ASSIGNMENT = re.compile(r"\w+=\S*$")
HOME = os.path.expanduser("~")


def unquote(word):
    if len(word) >= 2 and word[0] == word[-1] and word[0] in "\"'":
        word = word[1:-1]
    return os.path.expanduser(os.path.expandvars(word))


def joined(base, word):
    return os.path.normpath(os.path.join(base, unquote(word)))


class Shell:
    def __init__(self, directory):
        self.directory = directory
        self.previous = directory
        self.pushed = []

    def snapshot(self):
        return (self.directory, self.previous, list(self.pushed))

    def restore(self, snapshot):
        self.directory, self.previous, self.pushed = snapshot[0], snapshot[1], list(snapshot[2])

    def move(self, target):
        self.previous, self.directory = self.directory, target

    def run(self, name, argument):
        if name == "cd":
            if argument is None:
                self.move(HOME)
            elif argument == "-":
                self.move(self.previous)
            else:
                self.move(joined(self.directory, argument))
        elif name == "pushd":
            if argument is None:
                if self.pushed:
                    top = self.pushed.pop()
                    self.pushed.append(self.directory)
                    self.move(top)
            else:
                self.pushed.append(self.directory)
                self.move(joined(self.directory, argument))
        elif name == "popd" and self.pushed:
            self.move(self.pushed.pop())


def skip_quoted(text, index):
    quote = text[index]
    index += 1
    while index < len(text) and text[index] != quote:
        index += 2 if quote == '"' and text[index] == "\\" else 1
    return index + 1


def directory_at(position, git_dir=None):
    shell = Shell(cwd)
    scopes = []
    at_command = True
    index = 0
    text = command[:position]
    while index < len(text):
        char = text[index]
        if char in "'\"":
            index = skip_quoted(text, index)
            at_command = False
        elif text.startswith("$(", index):
            scopes.append(shell.snapshot())
            index += 2
            at_command = True
        elif char == "(":
            scopes.append(shell.snapshot())
            index += 1
            at_command = True
        elif char == ")":
            if scopes:
                shell.restore(scopes.pop())
            index += 1
            at_command = False
        elif char in ";&|\n{}":
            index += 1
            at_command = True
        elif char.isspace():
            index += 1
        elif at_command:
            word = WORD.match(text, index)
            if not word:
                index += 1
                continue
            index = word.end()
            name = word.group(0)
            if ASSIGNMENT.match(name):
                continue
            at_command = False
            if name in ("cd", "pushd", "popd"):
                while index < len(text) and text[index] in " \t":
                    index += 1
                argument = WORD.match(text, index) if name != "popd" else None
                value = None
                if argument and (argument.group(0) == "-" or not argument.group(0).startswith("-")):
                    value = argument.group(0)
                    index = argument.end()
                shell.run(name, value)
        else:
            word = WORD.match(text, index)
            index = word.end() if word else index + 1
    directory = shell.directory
    if git_dir:
        directory = joined(directory, git_dir)
    return directory


def git_in(directory, *args, timeout=10):
    return subprocess.run(
        ["git", "-C", directory, *args], capture_output=True, text=True, timeout=timeout
    )


def nearest_existing(directory):
    while not os.path.isdir(directory):
        parent = os.path.dirname(directory)
        if parent == directory:
            return None
        directory = parent
    return directory


def absolute_git_path(directory, flag):
    found = git_in(directory, "rev-parse", "--path-format=absolute", flag)
    if found.returncode != 0:
        return None
    return os.path.realpath(found.stdout.strip())


def shared_git_dir():
    own_checkout = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    return absolute_git_path(own_checkout, "--git-common-dir")


def is_shared_checkout(directory, shared):
    existing = nearest_existing(directory)
    if existing is None:
        return False
    own = absolute_git_path(existing, "--git-dir")
    return own is not None and own == shared


try:
    shared = shared_git_dir()
except Exception:
    shared = None

for pattern, name in rules:
    for match in re.finditer(pattern, command):
        try:
            if shared is None or not is_shared_checkout(directory_at(match.start(), match.group("dir")), shared):
                continue
        except Exception:
            pass
        print(
            f"Blocked: {name} in the shared checkout wipes other agents' uncommitted work. "
            "Undo your own hunks by editing the file; read an old version with `git show <rev>:<path>`; "
            "unstage with `git restore --staged <path>`. For branch work, use a git worktree or a scratch clone, "
            "where this guard lets it through.",
            file=sys.stderr,
        )
        sys.exit(2)

STALE_AFTER_SECONDS = 6 * 3600


def missing_upstream_age(directory):
    try:
        if git_in(directory, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip() != "main":
            return None
        git_in(directory, "fetch", "-q", "origin", "main", timeout=15)
        dates = git_in(directory, "log", "--first-parent", "--format=%ct", "HEAD..origin/main").stdout.split()
        if not dates:
            return None
        return len(dates), time.time() - int(dates[-1])
    except Exception:
        return None


commit = re.search(G + r"commit\b", command)
if commit:
    stale = missing_upstream_age(directory_at(commit.start(), commit.group("dir")))
    if stale and stale[1] > STALE_AFTER_SECONDS:
        count, age = stale
        print(
            f"Blocked: this checkout's main is {count} commits behind origin/main, and the oldest of them "
            f"reached origin/main {age / 3600:.0f} hours ago. Work built on it may target files that moved or no longer exist. "
            "Run `git pull --ff-only` (or `git pull --rebase` when main has local commits), check your change "
            "still applies to the current tree, then commit.",
            file=sys.stderr,
        )
        sys.exit(2)
sys.exit(0)
